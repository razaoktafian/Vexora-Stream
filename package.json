{
  "name": "vexora-stream",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "app": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "keywords": [
    "vexora",
    "stream",
    "tiktok-live",
    "youtube-live",
    "obs-dock",
    "obs-overlay"
  ],
  "author": "Vexora Studios",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "tiktok-live-connector": "^2.5.0",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vexorastudios.vexorastream",
    "productName": "Vexora Stream",
    "copyright": "Copyright © 2026 Vexora Studios",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "files": [
      "main.js",
      "server/**/*",
      "client/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true
  }
}
