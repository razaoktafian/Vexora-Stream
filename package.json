{
  "name": "vexora-stream",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "app": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:ui && tauri build",
    "dev:ui": "vite --config vite.config.mjs",
    "build:ui": "vite build --config vite.config.mjs"
  },
  "keywords": [
    "vexora",
    "stream",
    "tiktok-live",
    "youtube-live",
    "obs-dock",
    "obs-overlay"
  ],
  "author": "Vexora Studios",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tiktok-live-connector": "^2.5.0",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.vexorastudios.vexorastream",
    "productName": "Vexora Stream",
    "copyright": "Copyright © 2026 Vexora Studios",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "files": [
      "main.js",
      "server/**/*",
      "client/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true
  }
}
