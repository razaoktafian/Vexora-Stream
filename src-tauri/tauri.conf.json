{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vexora Stream",
  "version": "1.0.0",
  "identifier": "com.vexorastudios.vexorastream",
  "build": {
    "frontendDist": "../client",
    "devUrl": "http://localhost:3333",
    "beforeDevCommand": "node server/index.js",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vexora Stream — Unified Live Suite (TikTok + YouTube)",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
